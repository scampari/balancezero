# Copy to .env.prod (gitignored) and fill in. Consumed only by
# docker-compose.prod.yml:
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Public origin this deployment answers on -- the dedicated Tailscale
# node's MagicDNS name. PLAID_REDIRECT_URI and ALLOWED_ORIGIN are derived
# from it. Must match a redirect URI registered in the Plaid dashboard
# (Team Settings -> API), with /accounts appended.
PUBLIC_ORIGIN=https://balancezero.tailbae83d.ts.net

# Flask session / JWT signing key.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Password for the app's Postgres database (used only inside the compose network).
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Plaid PRODUCTION credentials (dashboard -> Team Settings -> Keys).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Fernet key encrypting stored Plaid access tokens at rest.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up OFFLINE and separately -- without it, every user must re-link
# their bank. To carry existing connections over from your dev database,
# reuse that database's PLAID_ENCRYPTION_KEY here instead of generating one.
PLAID_ENCRYPTION_KEY=

# Reusable, pre-authorized Tailscale auth key for the app's own tailnet
# node (admin console -> Settings -> Keys -> Generate auth key).
# "Reusable" on; leave "Ephemeral" off so the device and its name survive
# a container restart.
TS_AUTHKEY=
