# Copy to .env (gitignored) and fill in. app.py calls load_dotenv() at
# startup, so anything set here is picked up automatically. An explicit
# shell `export` still wins over .env (load_dotenv does not override).

# Flask / auth
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://balancezero_dev:balancezero_dev@localhost:55433/balancezero_dev

# Plaid — get credentials from https://dashboard.plaid.com (Team Settings -> Keys)
# PLAID_SECRET is per-environment: the Sandbox secret and the Production
# secret are different values. Use the one matching PLAID_ENV below.
PLAID_CLIENT_ID=
PLAID_SECRET=
# "sandbox" (fake data) or "production" (real banks).
# Production also requires: a Link use case set under Link -> Link
# Customization -> Data Transparency in the dashboard, and an https:// redirect
# URI (see PLAID_REDIRECT_URI). Some institutions (Chase, Fidelity, Schwab)
# need extra Production approval before they appear in Link.
PLAID_ENV=sandbox
# Fernet key for encrypting the stored Plaid access_token at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAID_ENCRYPTION_KEY=

# Needed for OAuth institutions (Chase, BofA, ...), which redirect the browser
# back to the app mid-Link. Must EXACTLY match an "Allowed redirect URI"
# registered in the Plaid dashboard (Team Settings -> API), minus query string.
#   production: https://balancezero.<tailnet>.ts.net/accounts   (https:// required)
#   sandbox:   http://localhost:5173/accounts                   (http allowed)
# Production disallows http:// and plain localhost — to run a production build
# locally you need an https:// origin (self-signed cert) or just point at the
# deployed host above. Leave unset for non-OAuth linking.
PLAID_REDIRECT_URI=

# Frontend origin allowed to call /api/* with credentials (dev only; prod is
# same-origin). Defaults to http://localhost:5173 if unset.
# ALLOWED_ORIGIN=http://localhost:5173

# Number of trusted reverse proxies in front of the app. Only needed in
# production behind the k3s/Tailscale ingress, so the login/signup rate
# limiter keys on the real client IP instead of the proxy's. Default 0.
# TRUSTED_PROXY_COUNT=1

# Max login / signup attempts per client IP per window (15 min / 60 min).
# Defaults 10 / 5 — raise where many real users share one egress IP.
# LOGIN_RATE_LIMIT_MAX=10
# SIGNUP_RATE_LIMIT_MAX=5
